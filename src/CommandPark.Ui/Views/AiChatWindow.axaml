<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="clr-namespace:CommandPark.Ui.Markup"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:CommandPark.Ui.ViewModels"
        xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
        x:Class="CommandPark.Ui.Views.AiChatWindow"
        x:DataType="viewModels:AiChatWindowViewModel"
        Title="{loc:Loc chat.title}"
        Width="660"
        Height="620"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur, None"
        ShowInTaskbar="False"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyBackgroundFallback="{DynamicResource SystemAltHighColor}"
        Topmost="True">

    <Window.Styles>
        <!-- 消息气泡：默认靠左（AI），用户消息靠右并换一个底色 -->
        <Style Selector="Border.chatmessage">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource Background50}"/>
        </Style>
        <Style Selector="Border.chatmessage.user">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="{DynamicResource InfoColor20}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="20">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <lucide:LucideIcon Kind="MessagesSquare"
                               Size="24"
                               StrokeWidth="1.8"
                               Foreground="{DynamicResource InfoColor}"
                               VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Loc chat.title}"
                       Classes="h4"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundColor}"/>
            <TextBlock Text="{loc:Loc chat.subtitle}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Foreground50}"/>
        </StackPanel>

        <!-- 对话区 -->
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="6"
                CornerRadius="{StaticResource XlCornerRadius}"
                Background="{DynamicResource Background25}">
            <ScrollViewer x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="viewModels:AiChatMessageViewModel"
                                      x:DataType="viewModels:AiChatMessageViewModel">
                            <Border Classes="chatmessage"
                                    Classes.user="{Binding IsUser}"
                                    MaxWidth="470"
                                    Margin="0,0,0,10"
                                    Padding="12,8"
                                    CornerRadius="{StaticResource XlCornerRadius}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Role}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Foreground50}"
                                               FontFamily="{StaticResource JetBrainsMono}"/>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource JetBrainsMono}"
                                               FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 输入区 -->
        <TextBox Grid.Row="2"
                 x:Name="InputBox"
                 Text="{Binding InputText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 MaxHeight="140"
                 Margin="0,12,0,0"
                 PlaceholderText="{loc:Loc chat.placeholder}"
                 FontFamily="{StaticResource JetBrainsMono}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- 状态与操作 -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{loc:Loc chat.replying}"
                           IsVisible="{Binding IsBusy}"
                           FontSize="12"
                           Foreground="{DynamicResource Foreground50}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource ErrorColor}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button x:Name="SendButton"
                        Content="{Binding SendLabel}"
                        IsEnabled="{Binding CanSend}"
                        Classes="Primary"
                        Click="Send_OnClick"/>
                <Button Content="{Binding CopyLabel}"
                        IsEnabled="{Binding HasMessages}"
                        Click="Copy_OnClick"/>
                <Button Content="{Binding ExportLabel}"
                        IsEnabled="{Binding HasMessages}"
                        Click="Export_OnClick"/>
                <Button Content="{Binding CloseLabel}"
                        Click="Close_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
