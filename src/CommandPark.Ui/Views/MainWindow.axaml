<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CommandPark.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:CommandPark.Ui.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CommandPark.Ui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CommandPark.Ui"
        Width="706"
        Height="760"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ShowInTaskbar="False"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur, None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyBackgroundFallback="{DynamicResource SystemAltHighColor}"
        Background="Transparent"
        Topmost="True"
        KeyUp="InputElement_OnKeyUp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Background="{DynamicResource Background25}"/>
        <ContentPresenter Content="{Binding InnerView}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

        <controls:RainbowBorder CornerRadius="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="8"
                                Opacity="0">
            <!--
                淡入淡出交给 Opacity 的 Transitions 补间：行为只切换目标值。
                不要用两个 FillMode="Forward" 的关键帧动画去抢同一个属性：
                上一个动画的保持值会在另一个动画结束时重新生效，表现为淡入后立刻弹回。
            -->
            <controls:RainbowBorder.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:2" Easing="ExponentialEaseOut"/>
                </Transitions>
            </controls:RainbowBorder.Transitions>

            <Interaction.Behaviors>
                <DataTriggerBehavior Binding="{Binding ShowRainbow}" Value="True">
                    <ChangePropertyAction PropertyName="Opacity" Value="1"/>
                </DataTriggerBehavior>

                <DataTriggerBehavior Binding="{Binding ShowRainbow}" Value="False">
                    <ChangePropertyAction PropertyName="Opacity" Value="0"/>
                </DataTriggerBehavior>
            </Interaction.Behaviors>
        </controls:RainbowBorder>
    </Grid>
</Window>
