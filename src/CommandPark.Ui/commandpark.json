{
  "$schema": "./commandpark.schema.json",
  "theme": "auto",
  "hotkey": "Ctrl+Alt+D",
  "clicks": {
    "maxEntries": 10000
  },
  "sources": {
    "envProgram": {},
    "everything": {
      "prefixMode": true,
      "batchSize": 4
    },
    "installedApplication": {
      "prefixMode": false,
      "skipNoise": true,
      "pinyinMode": true,
      "maxLength": 64,
      "excludes": []
    },
    "run": {
      "prefixMode": false
    },
    "latexCalc": {
      "prefixMode": true,
      "timeoutSeconds": 2
    },
    "bing": {
      "prefixMode": true
    },
    "welcome": {
      "showEditConfig": true,
      "showRepo": true,
      "showOfficial": true
    }
  }
}