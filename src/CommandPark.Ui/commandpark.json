{
  "$schema": "./commandpark.schema.json",
  "theme": "auto",
  "language": {
    "current": "auto",
    "fallback": ["zh_CN"]
  },
  "hotkey": "Ctrl+Alt+D",
  "clicks": {
    "maxEntries": 10000
  },
  "quickSelect": {
    "enabled": true,
    "modifier": "Alt",
    "functionKeys": false,
    "showWeight": false
  },
  "ai": {
    "provider": "kilo-free",
    "endpoint": "",
    "apiKey": "",
    "model": "",
    "session": "",
    "headers": {},
    "maxResults": 5,
    "temperature": 0.2
  },
  "sources": {
    "envProgram": {},
    "everything": {
      "prefixMode": true,
      "batchSize": 4
    },
    "installedApplication": {
      "prefixMode": false,
      "skipNoise": true,
      "pinyinMode": true,
      "maxLength": 64,
      "excludes": []
    },
    "run": {
      "prefixMode": false
    },
    "latexCalc": {
      "prefixMode": true,
      "timeoutSeconds": 2
    },
    "bing": {
      "prefixMode": true
    },
    "welcome": {
      "showEditConfig": true,
      "showRepo": true,
      "showOfficial": true
    }
  }
}