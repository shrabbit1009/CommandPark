{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commandpark.schema.json",
  "title": "CommandPark configuration",
  "description": "CommandPark 程序目录配置文件的 JSON Schema。",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "配置文件的 Schema 路径。"
    },
    "theme": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "auto",
        "light",
        "dark",
        null
      ],
      "default": "auto",
      "description": "主题模式：auto、light 或 dark；null 或不填时跟随系统。"
    },
    "hotkey": {
      "type": [
        "string",
        "null"
      ],
      "default": "Ctrl+Alt+D",
      "description": "后台程序监听的全局快捷键，例如 Ctrl+Alt+D、Win+Shift+S；不填时使用默认值 Ctrl+Alt+D，显式写 null 时不启动后台热键监听。"
    },
    "clicks": {
      "$ref": "#/$defs/clicks"
    },
    "quickSelect": {
      "$ref": "#/$defs/quickSelect"
    },
    "sources": {
      "type": "object",
      "description": "各搜索源的配置。未提供配置节的 IConfigReader 源不会运行。",
      "properties": {
        "envProgram": {
          "$ref": "#/$defs/envProgram"
        },
        "everything": {
          "$ref": "#/$defs/everything"
        },
        "installedApplication": {
          "$ref": "#/$defs/installedApplication"
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "latexCalc": {
          "$ref": "#/$defs/latexCalc"
        },
        "bing": {
          "$ref": "#/$defs/bing"
        },
        "welcome": {
          "$ref": "#/$defs/welcome"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "clicks": {
      "type": "object",
      "description": "点击权重（htt）配置。提供该节点即启用；点击越多，结果越靠前。",
      "properties": {
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 10000,
          "description": "本地最多保留的点击记录条数；超过后从最旧的记录开始删除。"
        }
      },
      "additionalProperties": false
    },
    "quickSelect": {
      "type": "object",
      "description": "快速选择视图：结果右侧显示点击权重与前 9 条的编号。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否显示权重与快速选择；关闭后修饰键+数字不再触发。"
        },
        "modifier": {
          "type": "string",
          "enum": ["Alt", "Ctrl"],
          "default": "Alt",
          "description": "触发快速选择的修饰键：按住它再按 1~9 打开对应结果。"
        },
        "functionKeys": {
          "type": "boolean",
          "default": false,
          "description": "是否额外支持直接按 F1~F9 打开对应结果（F1 = 第 1 条）。"
        },
        "showWeight": {
          "type": "boolean",
          "default": false,
          "description": "是否在结果右侧显示点击权重；默认关闭，避免出现一排 0。"
        }
      },
      "additionalProperties": false
    },
    "envProgram": {
      "type": "object",
      "description": "PATH 程序搜索源。提供空对象即启用；不提供该节点则禁用。",
      "additionalProperties": false
    },
    "everything": {
      "type": "object",
      "description": "Everything 文件搜索源。提供该节点即启用。",
      "properties": {
        "prefixMode": {
          "type": "boolean",
          "default": true,
          "description": "是否只在输入 # 或 et: 前缀时运行。"
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 4,
          "description": "每次从 Everything 请求的结果数。"
        }
      },
      "additionalProperties": false
    },
    "installedApplication": {
      "type": "object",
      "description": "开始菜单已安装程序搜索源。提供该节点即启用。",
      "properties": {
        "prefixMode": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时只有输入 $、ap:、app: 或 ia: 前缀才运行。"
        },
        "skipNoise": {
          "type": "boolean",
          "default": true,
          "description": "是否过滤卸载、说明、网站等噪音快捷方式。"
        },
        "pinyinMode": {
          "type": "boolean",
          "default": true,
          "description": "是否启用连续拼音和拼音首字母匹配。"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "default": 64,
          "description": "名称超过该长度时视为描述型噪音。"
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "description": "额外排除的名称或路径关键字。"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "description": "运行输入命令的搜索源。提供该节点即启用。",
      "properties": {
        "prefixMode": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时只有输入 @、run: 或 r: 前缀才运行该源。"
        }
      },
      "additionalProperties": false
    },
    "latexCalc": {
      "type": "object",
      "description": "LaTeX / AngouriMath 计算源。提供该节点即启用。",
      "properties": {
        "prefixMode": {
          "type": "boolean",
          "default": true,
          "description": "为 true 时只有输入 ~、c: 或 calc: 前缀才运行。"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 2,
          "description": "单次表达式计算的超时时间（秒）。"
        }
      },
      "additionalProperties": false
    },
    "bing": {
      "type": "object",
      "description": "Bing 网络搜索源。提供该节点即启用。",
      "properties": {
        "prefixMode": {
          "type": "boolean",
          "default": true,
          "description": "为 true 时只有输入 b: 或 bs: 前缀才运行该源。"
        }
      },
      "additionalProperties": false
    },
    "welcome": {
      "type": "object",
      "description": "空查询时显示的首屏欢迎源。提供该节点即启用。",
      "properties": {
        "showEditConfig": {
          "type": "boolean",
          "default": true,
          "description": "是否显示“修改 CommandPark 配置文件”。"
        },
        "showRepo": {
          "type": "boolean",
          "default": true,
          "description": "是否显示项目仓库入口。"
        },
        "showOfficial": {
          "type": "boolean",
          "default": true,
          "description": "是否显示 shRabbit 官方网站入口。"
        }
      },
      "additionalProperties": false
    }
  }
}
