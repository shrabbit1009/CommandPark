<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <!-- 后台程序（C++）由主程序在首次启动时拉起，构建时复制到主程序旁边。
         需要先构建 CommandPark.Background.Cpp；文件不存在时会自动跳过。 -->
    <PropertyGroup>
        <CommandParkBackgroundPlatform Condition="'$(CommandParkBackgroundPlatform)' == ''">x64</CommandParkBackgroundPlatform>
        <CommandParkBackgroundPath Condition="'$(CommandParkBackgroundPath)' == ''">$(MSBuildThisFileDirectory)..\CommandPark.Background.Cpp\bin\$(CommandParkBackgroundPlatform)\$(Configuration)\CommandPark.Background.Cpp.exe</CommandParkBackgroundPath>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(CommandParkBackgroundPath)')">
        <None Include="$(CommandParkBackgroundPath)">
            <Link>CommandPark.Background.Cpp.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
        <None Update="commandpark.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="commandpark.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Lucide.Avalonia" Version="0.2.23" />
        <PackageReference Include="ShadUI" Version="0.2.4" />
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CommandPark.Background\CommandPark.Background.csproj" />
      <ProjectReference Include="..\CommandPark\CommandPark.csproj" />
    </ItemGroup>
</Project>
