<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- 发布者（公司）：exe 属性页与任务管理器显示它；安装程序里的同名信息在 installer\CommandPark.iss 的 MyAppPublisher -->
        <Company>shRabbit</Company>
        <!-- 可执行文件图标（资源管理器、开始菜单、任务管理器、托盘、卸载列表都用它）。源文件在 assets\logo\out\，改图标时把新版复制到 Assets\Icons\ 再改这一处，并同步 installer\CommandPark.iss -->
        <ApplicationIcon>Assets\Icons\black-line-full.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- 后台程序（C++）由主程序在首次启动时拉起，构建时复制到主程序旁边。
         需要先构建 CommandPark.Background.Cpp；文件不存在时会自动跳过。 -->
    <PropertyGroup>
        <CommandParkBackgroundPlatform Condition="'$(CommandParkBackgroundPlatform)' == ''">x64</CommandParkBackgroundPlatform>
        <CommandParkBackgroundPath Condition="'$(CommandParkBackgroundPath)' == ''">$(MSBuildThisFileDirectory)..\CommandPark.Background.Cpp\bin\$(CommandParkBackgroundPlatform)\$(Configuration)\CommandPark.Background.Cpp.exe</CommandParkBackgroundPath>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(CommandParkBackgroundPath)')">
        <None Include="$(CommandParkBackgroundPath)">
            <Link>CommandPark.Background.Cpp.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!-- 许可证与第三方声明：随程序一起发布（安装包与压缩包都会带上） -->
    <ItemGroup>
        <None Include="..\..\LICENSE" Link="LICENSE">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
        <None Update="commandpark.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="commandpark.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Lucide.Avalonia" Version="0.2.23" />
        <PackageReference Include="ShadUI" Version="0.2.4" />
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
    </ItemGroup>

    <ItemGroup>
      <!-- 真正的后台程序是 C++ 那个（上面用 None 复制过来）；
           src\CommandPark.Background 是早期 C# 原型、UI 没有用到它的任何类型，
           不引用它，发布目录里就不会混进非 AOT 的托管 exe/dll。 -->
      <ProjectReference Include="..\CommandPark\CommandPark.csproj" />
    </ItemGroup>
</Project>
